# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_db
DATABASE_URL=postgresql+asyncpg://resume_user:resume_pass@postgres:5432/resume_db

# ── Authentication ─────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10
FAISS_INDEX_DIR=/app/data/faiss_index

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
